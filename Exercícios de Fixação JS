IF / ELSE

*** Saldo bancário ***

let saldo = prompt("Qual seu saldo bancário?");
let valorCompra = prompt("Qual o valor da compra? ")

if(saldo >= valorCompra) {
    console.log("Compra autorizada!");
}
else {
    console.log("Saldo insuficiente!");
}


** Negativo ou positivo? **

let numero = prompt("Digite um número: ");

if(numero < 0) {
    console.log("Número negativo!");
}
else if(numero === 0) {
    console.log("Número igual a zero!");
}
else {
    console.log("Número positivo!");
}


** Poder de compra **

let valorCompra = prompt('Digite o valor da sua compra: ');

if (valorCompra > 200) {
    let desconto = valorCompra * (20 / 100);
    let valor_atualizado = valorCompra - desconto;
    console.log("Sua compra tem direito ao desconto de 20% e o valor atualizado é de:" + valor_atualizado);
}

else {
    console.log("Sua compra é no valor de:" + valorCompra);
}
